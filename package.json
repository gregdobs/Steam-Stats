{
  "name": "steam-dashboard",
  "private": true,
  "version": "1.1.0",
  "description": "A personal gaming analytics dashboard powered by the Steam Web API, HowLongToBeat, and your local Steam installation.",
  "author": "Greg",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"vite --port 5173\"",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "concurrently \"npm run server\" \"vite --port 5173\"",
    "build:exe": "npm run build && pkg . --output 'dist-exe/Steam Stats'",
    "build:exe:win": "npm run build && pkg . --target node22-win-x64 --output 'dist-exe/Steam Stats.exe'",
    "build:release": "node build-release.js",
    "test": "vitest run"
  },
  "bin": "bootstrap.cjs",
  "pkg": {
    "assets": [
      "dist/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist-exe"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "chart.js": "^4.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "@yao-pkg/pkg": "^6.21.0",
    "vite": "^5.3.1",
    "vitest": "^4.1.10"
  }
}
