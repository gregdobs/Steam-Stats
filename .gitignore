# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Legacy cache dotfiles — server.js now stores these under the OS user
# data folder (see getDataDir() in server.js) and migrates any leftover
# copies of these out of the repo root on startup. Keeping the patterns
# here defensively in case an old clone still has them.
.hltb-state.json
.genre-cache.json
.rarity-cache.json

# Release build output
dist-exe/
release/

# Claude Code — personal machine overrides shouldn't be shared;
# CLAUDE.md itself (project memory) is meant to be committed
.claude/settings.local.json

# Env files — not currently used, but ignored preemptively so a future
# local secret never ends up committed by accident
.env
.env.local

# Delivery zips from chat sessions — meant to be unzipped and discarded,
# not committed
*.zip
