# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# HLTB session state (contains tokens, regenerated automatically)
.hltb-state.json

# Genre cache (regenerated automatically, can be large)
.genre-cache.json

# Achievement rarity cache (regenerated automatically)
.rarity-cache.json

# Release build output
dist-exe/
release/

# Claude Code — personal machine overrides shouldn't be shared;
# CLAUDE.md itself (project memory) is meant to be committed
.claude/settings.local.json

# Env files — not currently used, but ignored preemptively so a future
# local secret never ends up committed by accident
.env
.env.local

# Delivery zips from chat sessions — meant to be unzipped and discarded,
# not committed
*.zip
